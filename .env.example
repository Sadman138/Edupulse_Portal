# =====================================================================
# EduPulse MERN Stack Platform — Environment Template
# Department of Computer Science & Engineering, Metropolitan University
# =====================================================================

# Server Port
PORT=3000

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# ---------------------------------------------------------------------
# MongoDB Connection String (Mongoose ODM)
# ---------------------------------------------------------------------
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/edupulse_db

# Or MongoDB Atlas Cloud Cluster:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/edupulse_db?retryWrites=true&w=majority

# ---------------------------------------------------------------------
# Email Verification OTP Credentials (Gmail SMTP)
# ---------------------------------------------------------------------
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here
